# Docker file for building MuJoCo. This should match MuJoCo's official build environment.
ARG UBUNTU_VERSION=22.04
FROM ubuntu:${UBUNTU_VERSION}

ARG DEBIAN_FRONTEND=noninteractive

# Build tools (git and ca-certificates for CMake FetchContent, the lib*-dev packages for GLFW).
# One layer, no recommended packages, no package lists left in the image.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        clang-13 \
        cmake \
        git \
        libgl1-mesa-dev \
        libwayland-dev \
        libxcursor-dev \
        libxi-dev \
        libxinerama-dev \
        libxkbcommon-dev \
        libxrandr-dev \
        ninja-build \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

# Rust (also add curl to the packages above)
# RUN curl https://sh.rustup.rs -sSf | bash -s -- -y

# ENV MUJOCO_STATIC_LINK_DIR=/mujoco/lib/
# ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /mujoco/

# Commands.
# Note that we enable LTO with -DMUJOCO_ENABLE_LTO:BOOL=ON and
# tell CMake to build static libs with -DBUILD_SHARED_LIBS:BOOL=OFF.
# -----------------------------------------
# docker buildx build . -t mujoco-build -f Dockerfile.ubuntu
# -----------------------------------------
# docker run --rm --volume /path/to/mujoco/:/mujoco/ -it mujoco-build:latest
# -----------------------------------------
# cmake -S . -B build \
#     -DCMAKE_BUILD_TYPE:STRING=Release \
#     -DMUJOCO_ENABLE_LTO:BOOL=ON \
#     -DCMAKE_INSTALL_PREFIX:STRING=${TMPDIR}/mujoco_install \
#     -DMUJOCO_BUILD_EXAMPLES:BOOL=OFF \
#     -DMUJOCO_BUILD_TESTS=OFF \
#     -DBUILD_SHARED_LIBS:BOOL=OFF \
#     -G Ninja \
#     -DCMAKE_C_COMPILER:STRING=clang-13 \
#     -DCMAKE_CXX_COMPILER:STRING=clang++-13 \
#     -DMUJOCO_HARDEN:BOOL=ON
# -----------------------------------------
# cmake --build build --parallel --target libmujoco_simulate --config=Release
# -----------------------------------------
# export MUJOCO_STATIC_LINK_DIR=$(realpath mujoco/build/lib/)
# cargo run ...
# -----------------------------------------
